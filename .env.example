# Entorno
NODE_ENV=development

# Servidor
PORT=3000
PUBLIC_BASE_URL="http://localhost:3000"

# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bot_whatsapp"

# Secreto fijo compartido por todas las tools de venta (POST /tools/*).
# La identidad de quien llama viene de merchantId/contactPhone en el body,
# nunca de este secreto.
TOOLS_SHARED_SECRET=""

# --- Meta WhatsApp Cloud API (una sola WABA nuestra) ---
META_GRAPH_VERSION="v21.0"
# Token permanente de system user de la WABA.
META_ACCESS_TOKEN=""
# Para verificar `X-Hub-Signature-256` de los webhooks.
META_APP_SECRET=""
# El que se configura al suscribir el webhook en el dashboard de Meta.
META_VERIFY_TOKEN=""

# --- n8n (agente vendedor) ---
N8N_WEBHOOK_BASE_URL="http://localhost:5678/webhook"
# Header que el backend manda a n8n y que el workflow exige.
N8N_WEBHOOK_SECRET=""

# --- API del panel del comercio ---
# Origen exacto del SPA (repo separado) para CORS.
PANEL_ORIGIN="http://localhost:5173"
