# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/zavu_mvp?schema=public"

# Servidor
PORT=3000
PUBLIC_BASE_URL="http://localhost:3000"

# Zavu (zavu.dev) — cuenta principal, una sola API key para todo el proyecto
ZAVU_API_KEY=""
# senderId del número operador (agente zavu-operador), se completa tras crearlo a mano en el dashboard de Zavu.
# Su webhook debe suscribirse a "invitation.status_changed" (evento de proyecto, no de un sender de comercio)
# además de "message.inbound" — es el único sender que nosotros controlamos desde el arranque.
ZAVU_OPERATOR_SENDER_ID=""
# Secreto de firma v2 DE ESE sender (senders.create/regenerateWebhookSecret). No es un secreto de proyecto: cada sender tiene el suyo.
ZAVU_OPERATOR_WEBHOOK_SECRET=""

# Secreto fijo compartido por TODAS las Agent Tools de este proyecto (cualquier
# comercio y el operador). Lo elegimos nosotros al crear cada tool con Zavu;
# la identidad de quien llama viene de context.contactPhone, no de este secreto.
ZAVU_TOOLS_WEBHOOK_SECRET=""

# Anthropic (extracción de menú por foto/PDF)
ANTHROPIC_API_KEY=""

# Plantilla "pago_en_revision", aprobada por Meta. Se crea con
# scripts/setup-template-pago-en-revision.ts; este es el `id` de Zavu (no el
# nombre) que devuelve al crearla. Se usa para avisarle al comercio de un
# comprobante pendiente cuando la ventana de 24h está cerrada.
ZAVU_PAGO_EN_REVISION_TEMPLATE_ID=""
